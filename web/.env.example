# Copy to web/.env.local. Never commit real values. Testnet keys only.

# AI provider (server only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Pyth Hermes (required since 2026-08-26)
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# Signers (server only, 0x-prefixed 32-byte hex)
PROPOSER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
AGENT_RISK_PRIVATE_KEY=
AGENT_YIELD_PRIVATE_KEY=
AGENT_SECURITY_PRIVATE_KEY=
AGENT_MARKET_PRIVATE_KEY=
AGENT_HISTORY_PRIVATE_KEY=

# Public (optional)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
