# DecMarkt web — environment variables.
# Local: copy to web/.env.local. Vercel: Project → Settings → Environment Variables.
# Secrets are left empty on purpose: an empty value is reported as "not configured".
# Never commit real values. Testnet keys only; fund them with test MON only.
#
# Contract addresses, chain id, explorer and the Pyth contract/feed are NOT configured here:
# they are public, committed in lib/chain/deployments.10143.json and lib/config/public.ts,
# and verified against the chain.

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC — bundled into the browser. Nothing secret may ever use NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Monad Testnet RPC used by the browser and the server. Default shown.
# Must serve chain id 10143. Also added to the CSP connect-src.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ─────────────────────────────────────────────────────────────────────────────
# PRIVATE — server only. Read in `server-only` modules; never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# AI provider for the five agents. One key is required for any round (simulation or live).
# AI_PROVIDER: gemini | anthropic (default: gemini; anthropic only if ANTHROPIC_API_KEY is the only key).
# Key: https://aistudio.google.com/apikey — GOOGLE_API_KEY is accepted as an alias.
# Check the connection with: npm run gemini:check
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional. Gemini defaults: gemini-3.8-flash, fallbacks gemini-3.7-flash,gemini-3.6-flash
AI_MODEL=
AI_FALLBACK_MODEL=
# Only with AI_PROVIDER=anthropic (default model claude-opus-5). Needs account credit.
ANTHROPIC_API_KEY=
# Optional OpenAI-compatible provider (same prompt, same validation). Used as a fallback when
# Gemini fails for provider reasons (key, credit, quota, outage), or first with AI_PROVIDER=openai|groq|openrouter.
# Groq preset: only GROQ_API_KEY (free key at https://console.groq.com/keys; model llama-3.3-70b-versatile).
GROQ_API_KEY=
# OpenRouter preset: OPENROUTER_API_KEY + OPENAI_MODEL. Any other endpoint: OPENAI_API_KEY (+ OPENAI_BASE_URL) + OPENAI_MODEL.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Pyth Hermes. Required for signed prices (execute, resolve, verification).
# The key must be entitled to the reference feed (ETH/USD).
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# Operator sessions. Required for live mode. 32+ random characters: `openssl rand -hex 32`
SESSION_SECRET=

# Signers for live mode: 0x-prefixed 32-byte hex. Each must be the address registered on
# chain for its role (contracts/DEPLOYMENTS.md). Required for live mode only.
PROPOSER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
AGENT_RISK_PRIVATE_KEY=
AGENT_YIELD_PRIVATE_KEY=
AGENT_SECURITY_PRIVATE_KEY=
AGENT_MARKET_PRIVATE_KEY=
AGENT_HISTORY_PRIVATE_KEY=

# Payload store (Vercel Blob) for off-chain state, questions and agent reasons.
# Recommended in production: without it only hashes are on chain and reasons cannot be shown.
# In development the local filesystem (web/.data) is used instead.
BLOB_READ_WRITE_TOKEN=
